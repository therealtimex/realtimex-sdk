{
    "name": "@realtimex/sdk",
    "version": "2.0.17",
    "description": "SDK for building Local Apps that integrate with RealtimeX",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./v1": {
            "types": "./dist/v1/index.d.ts",
            "import": "./dist/v1/index.mjs",
            "require": "./dist/v1/index.js"
        },
        "./cli": {
            "types": "./dist/cli/index.d.ts",
            "import": "./dist/cli/index.mjs",
            "require": "./dist/cli/index.js"
        }
    },
    "scripts": {
        "build": "node ../scripts/generate-v1-sdk.mjs --force && tsup src/index.ts src/v1/index.ts src/cli/index.ts --format cjs,esm --dts --clean",
        "dev": "tsup src/index.ts src/v1/index.ts src/cli/index.ts --format cjs,esm --dts --watch",
        "test": "vitest run --passWithNoTests",
        "sdk:generate": "node ../scripts/generate-v1-sdk.mjs",
        "sdk:generate:force": "node ../scripts/generate-v1-sdk.mjs --force",
        "sdk:diff": "node ../scripts/generate-v1-sdk.mjs --dry-run",
        "skill:generate": "node ../scripts/generate-skill.mjs --force",
        "skill:local-test": "node ../scripts/local-test-realtimex-skill.mjs",
        "pp-cli:build": "node ../scripts/build-pp-cli-packages.mjs",
        "pp-cli:publish": "node ../scripts/publish-pp-cli-packages.mjs",
        "prepublishOnly": "npm run build && npm run skill:generate"
    },
    "keywords": [
        "realtimex",
        "local-apps",
        "sdk",
        "supabase"
    ],
    "author": "RealtimeX Team",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.10.0",
        "rollup": "^4.55.1",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0",
        "vitest": "^1.0.0"
    },
    "files": [
        "dist",
        "skills",
        "README.md"
    ],
    "engines": {
        "node": ">=18.0.0"
    }
}
