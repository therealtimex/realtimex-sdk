{
  "name": "@realtimex/sdk",
  "version": "2.0.17",
  "description": "RealtimeX runtime SDK package and moderator agent skill assets.",
  "private": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "require": "./index.js",
      "types": "./index.d.ts"
    },
    "./skills/*": "./skills/*"
  },
  "scripts": {
    "sdk:generate": "node ../scripts/generate-sdk.mjs",
    "skill:generate": "node ../scripts/generate-skill.mjs --force",
    "pp-cli:build": "node ../scripts/build-pp-cli-packages.mjs",
    "pp-cli:publish": "node ../scripts/publish-pp-cli-packages.mjs"
  },
  "keywords": [
    "realtimex",
    "cli",
    "agent-skill"
  ],
  "author": "RealtimeX Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "skills",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
