                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Required user message to send to the thread.",
                    "minLength": 1
                  },
                  "attachments": {
                    "type": "array",
                    "description": "Optional attachments using the app chat attachment shape.",
                    "items": {
                      "type": "object"
                    }
                  },
                  "webSearchEnabled": {
                    "type": "boolean",
                    "description": "Optional web search toggle for this one message."
                  },
                  "broadcastThreadEvents": {
                    "type": "boolean",
                    "description": "Broadcast thread events to connected UI subscribers. Defaults to true."
                  },
                  "stripAgentPrefixForDelivery": {
                    "type": "boolean",
                    "description": "Strip @agent prefixes before delivery unless explicitly disabled. Defaults to true."
                  },
                  "channelTurnId": {
                    "type": "string",
                    "description": "Optional caller-provided id for correlating this CLI turn."
                  }
                },
                "additionalProperties": true
              }
            }
          }
        }
      }
