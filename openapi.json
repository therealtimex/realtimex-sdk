  "paths": {
    "/cli/prepare": {
      "get": {
        "tags": [
          "Prepare"
        ],
        "description": "Return compact workspace, thread, current workspace/thread from explicit workspaceSlug and threadSlug query parameters, LLM provider, model, and CLI agent context for agents before choosing arguments. Agents should pass --workspace-slug \"$RTX_WORKSPACE_SLUG\" and --thread-slug \"$RTX_THREAD_SLUG\" when those environment variables exist.",
        "operationId": "prepare",
        "parameters": [
          {
            "name": "x-app-id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workspaceSlug",
            "in": "query",
            "required": false,
            "description": "Current workspace slug from the caller context. Pass the RTX_WORKSPACE_SLUG environment value here when available.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "threadSlug",
            "in": "query",
            "required": false,
            "description": "Current thread slug from the caller context. Pass the RTX_THREAD_SLUG environment value here when available.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Compact context for CLI agents.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "currentWorkspace": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "number",
                          "example": 1
                        },
                        "slug": {
                          "type": "string",
                          "example": "workspace-slug"
                        },
                        "name": {
                          "type": "string",
                          "example": "Workspace"
                        },
                        "missing": {
                          "type": "boolean",
                          "example": false
                        }
                      }
                    },
                    "currentThread": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "number",
                          "example": 1
                        },
                        "slug": {
                          "type": "string",
                          "example": "thread-slug"
                        },
                        "name": {
                          "type": "string",
                          "example": "Thread"
                        },
                        "workspaceId": {
                          "type": "number",
                          "example": 1
                        },
                        "workspaceSlug": {
                          "type": "string",
                          "example": "workspace-slug"
                        },
                        "missing": {
                          "type": "boolean",
                          "example": false
                        }
                      }
                    },
                    "workspaces": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number",
                            "example": 1
                          },
                          "slug": {
                            "type": "string",
                            "example": "workspace-slug"
                          },
                          "name": {
                            "type": "string",
                            "example": "Workspace"
                          }
                        }
                      }
                    },
                    "threads": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number",
                            "example": 1
                          },
                          "slug": {
                            "type": "string",
                            "example": "thread-slug"
                          },
                          "name": {
                            "type": "string",
                            "example": "Thread"
                          },
                          "workspaceId": {
                            "type": "number",
                            "example": 1
                          },
                          "workspaceSlug": {
                            "type": "string",
                            "example": "workspace-slug"
                          }
                        }
                      }
                    },
                    "providers": {
                      "type": "array",
                      "example": [],
                      "items": {}
                    },
                    "models": {
                      "type": "array",
                      "example": [],
                      "items": {}
                    },
                    "agents": {
                      "type": "array",
                      "example": [],
                      "items": {}
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "currentWorkspace": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "number",
                          "example": 1
                        },
                        "slug": {
                          "type": "string",
                          "example": "workspace-slug"
                        },
                        "name": {
                          "type": "string",
                          "example": "Workspace"
                        },
                        "missing": {
                          "type": "boolean",
                          "example": false
                        }
                      }
                    },
                    "currentThread": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "number",
                          "example": 1
                        },
                        "slug": {
                          "type": "string",
                          "example": "thread-slug"
                        },
                        "name": {
                          "type": "string",
                          "example": "Thread"
                        },
                        "workspaceId": {
                          "type": "number",
                          "example": 1
                        },
                        "workspaceSlug": {
                          "type": "string",
                          "example": "workspace-slug"
                        },
                        "missing": {
                          "type": "boolean",
                          "example": false
                        }
                      }
                    },
                    "workspaces": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number",
                            "example": 1
                          },
                          "slug": {
                            "type": "string",
                            "example": "workspace-slug"
                          },
                          "name": {
                            "type": "string",
                            "example": "Workspace"
                          }
                        }
                      }
                    },
                    "threads": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number",
                            "example": 1
                          },
                          "slug": {
                            "type": "string",
                            "example": "thread-slug"
                          },
                          "name": {
                            "type": "string",
                            "example": "Thread"
                          },
                          "workspaceId": {
                            "type": "number",
                            "example": 1
                          },
                          "workspaceSlug": {
                            "type": "string",
                            "example": "workspace-slug"
                          }
                        }
                      }
                    },
                    "providers": {
                      "type": "array",
                      "example": [],
                      "items": {}
                    },
                    "models": {
                      "type": "array",
                      "example": [],
                      "items": {}
                    },
                    "agents": {
                      "type": "array",
                      "example": [],
                      "items": {}
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
