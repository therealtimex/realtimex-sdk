              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "example": "user"
                },
                "content": {
                  "type": "string",
                  "example": "Hello"
                }
              }
            }
          },
          "model": {
            "type": "string",
            "example": "gpt-4o"
          },
          "temperature": {
            "type": "number",
            "example": 0.7
          },
          "max_tokens": {
            "type": "number",
            "example": 1000
          }
        },
        "xml": {
          "name": "ChatRequest"
        }
      }
    },
