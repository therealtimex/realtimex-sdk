    "/cli/create-channel/{workspaceSlug}": {
      "post": {
        "tags": [
          "Channels"
        ],
        "description": "Create a chat channel in one exact workspace. Defaults to Telegram when plugin_type, channelType, and type are omitted. Use flat botToken and thread_id fields instead of nested config/settings.",
        "operationId": "createChannel",
        "parameters": [
          {
            "name": "workspaceSlug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-app-id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Human-readable channel name."
                  },
                  "plugin_type": {
                    "type": "string",
                    "description": "Channel plugin type. Defaults to telegram.",
                    "enum": [
                      "telegram",
                      "discord",
                      "zalo"
                    ],
                    "default": "telegram"
                  },
                  "channelType": {
                    "type": "string",
                    "description": "CLI-friendly alias for plugin_type.",
                    "enum": [
                      "telegram",
                      "discord",
                      "zalo"
                    ]
                  },
                  "type": {
                    "type": "string",
                    "description": "CLI-friendly alias for plugin_type.",
                    "enum": [
                      "telegram",
                      "discord",
                      "zalo"
                    ]
                  },
                  "botToken": {
                    "type": "string",
                    "description": "Bot token for telegram, discord, or zalo. The API maps this to config.botToken internally."
                  },
                  "thread_id": {
                    "type": "number",
                    "description": "Thread id to attach the channel to. The API maps this to settings.thread_id internally."
                  },
                  "threadId": {
                    "type": "number",
                    "description": "Alias for thread_id."
                  },
                  "autoStart": {
                    "type": "boolean",
                    "description": "Start the channel immediately after create. Defaults to true."
                  },
                  "autostart": {
                    "type": "boolean",
                    "description": "Alias for autoStart."
                  },
                  "start": {
                    "type": "boolean",
                    "description": "Alias for autoStart."
                  },
                  "enabled": {
                    "type": "boolean",
                    "description": "Compatibility field. Defaults to the autoStart value."
                  },
                  "config": {
                    "type": "object",
                    "description": "Compatibility field; prefer flat botToken."
                  },
                  "settings": {
                    "type": "object",
                    "description": "Compatibility field; prefer flat thread_id."
                  }
                }
              }
            }
          }
        }
      }
    },
